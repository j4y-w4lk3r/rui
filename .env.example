# Copy to .env (gitignored) and fill in the values for your router.
#
#   cp .env.example .env
#   $EDITOR .env
#   rui

# REQUIRED: admin user on the router web UI.
# On Orange Livebox / Funbox boxes the default factory user is `admin`,
# the password is the WPA2 PSK printed on the sticker (until you change it).
username=admin
password=your-router-admin-password

# OPTIONAL: defaults to 192.168.1.1 — the factory IP on Livebox/Funbox.
# Set this if you've moved the LAN to a different subnet, or if you're
# bridging through another router.
# ROUTER_HOST=192.168.1.1
