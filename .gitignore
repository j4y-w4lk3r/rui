# Binary names that match `go build ./cmd/<name>` output. Anchored to the
# repo root so they don't accidentally hide our cmd/<name>/ source dirs.
/rui
/orange-tui
/devices
/probe
/diagnose
/lab
/capture
/login-dump
*.exe

# goreleaser snapshot/release output. Re-created on every build.
/dist/

# Research-toolkit output dirs (cmd/capture, cmd/diagnose, cmd/lab).
captures/
reports/
debug.log
lab.log
devices.log

.DS_Store
