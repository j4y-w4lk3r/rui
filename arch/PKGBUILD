# Maintainer: j4y <j4y_w4lk3r@pobox.com>
#
# rui-bin — terminal UI for managing home routers (Orange Livebox/Funbox).
#
# Binary package: pulls the prebuilt linux-x86_64 tarball that goreleaser
# attaches to every GitHub release. No Go toolchain needed at install time.
# A future `rui` (source) package can build from source if anyone wants
# arm64 or non-glibc support; until then this covers 99% of Arch users.
#
# Release flow:
#   1. `git tag vX.Y.Z && git push origin vX.Y.Z`
#   2. .github/workflows/release.yml runs goreleaser, which uploads
#      rui_X.Y.Z_Linux_x86_64.tar.gz to the release.
#   3. `arch/aur-bump.sh X.Y.Z` updates pkgver + sha256 + .SRCINFO and
#      pushes to aur.archlinux.org/rui-bin.git.

pkgname=rui-bin
_pkgname=rui
pkgver=0.1.0
pkgrel=1
pkgdesc="Terminal UI for managing home routers (Orange Livebox/Funbox; Play/Fritz on the roadmap)"
arch=('x86_64')
url="https://github.com/j4y-w4lk3r/rui"
license=('MIT')
depends=('glibc')
optdepends=(
    'chromium: --capture mode (records router web UI traffic) needs a Chrome/Chromium binary'
    'xdg-utils: ergonomic clipboard support for `y`/`Y` device-copy keys'
)
provides=("${_pkgname}")
conflicts=("${_pkgname}" "${_pkgname}-git")

# Replaced per release by `arch/aur-bump.sh`.
source=("${_pkgname}-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/${_pkgname}_${pkgver}_Linux_x86_64.tar.gz")
sha256sums=('SKIP')

package() {
    cd "${srcdir}"

    install -Dm755 "${_pkgname}" "${pkgdir}/usr/bin/${_pkgname}"

    install -Dm644 LICENSE   "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
